{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semaphore.invalid/contracts/http.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/create"
    },
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "casual",
            "event"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "mode",
        "artifact_id"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "clue": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "command_id",
        "expected_revision",
        "clue"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "not_found",
            "receipt_not_found",
            "game_expired",
            "unavailable"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
