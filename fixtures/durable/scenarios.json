      "path": "/api/v1/auth/signup",
      "request_case": "signup",
      "status": 201,
      "response_case": "session"
    },
    {
      "name": "login",
      "method": "post",
      "path": "/api/v1/auth/login",
      "request_case": "login",
      "status": 200,
      "response_case": "session"
    },
    {
      "name": "session-expired",
      "method": "get",
      "path": "/api/v1/auth/session",
      "status": 401,
      "response_case": "unauthenticated"
    },
    {
      "name": "signup-disabled",
      "method": "post",
      "path": "/api/v1/auth/signup",
      "request_case": "signup",
      "status": 403,
      "response_case": "signup_disabled"
    },
    {
      "name": "csrf-rejected",
      "method": "post",
