{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semaphore.invalid/draft-w2/http.schema.json",
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "path",
              "code"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9_]{3,32}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "enum": [
            "player",
            "admin"
          ]
        }
      },
      "required": [
        "user_id",
        "login",
        "display_name",
        "role"
      ],
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_]{3,32}$"
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "login",
        "password"
      ],
      "additionalProperties": false
    },
    "login": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_]{3,32}$"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "login",
        "password"
      ],
      "additionalProperties": false
    },
    "authResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/$defs/user"
        },
        "csrf_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "user",
        "csrf_token"
      ],
      "additionalProperties": false
    },
    "createGame": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "required": [
        "pack_id",
        "pack_version"
      ],
      "additionalProperties": false
    },
    "uploadJob": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "rejected",
            "failed",
            "published"
          ]
        },
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "report": {
          "$ref": "verification.schema.json"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "job_id",
        "status",
        "pack_id",
        "pack_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            }
          },
          "then": {
            "required": [
              "report"
            ],
            "properties": {
              "report": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "packSummary": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8
        },
        "hidden": {
          "type": "boolean"
        },
        "verification": {
          "$ref": "verification.schema.json"
        },
        "self_report": {
          "$ref": "manifest.schema.json#/$defs/selfReport"
        }
      },
      "required": [
        "pack_id",
        "version",
        "name",
        "author",
        "description",
        "tags",
        "hidden",
        "verification"
      ],
      "additionalProperties": false
    },
    "packList": {
      "type": "object",
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packSummary"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "packs",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "leaderboard": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "challenge_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "game_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "completed_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "position",
              "display_name",
              "score",
              "game_id",
              "completed_at_ms"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pack_id",
        "pack_version",
        "challenge_id",
        "rows",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "moderate": {
      "type": "object",
      "properties": {
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "hidden"
      ],
      "additionalProperties": false
    },
    "challengeCreate": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      },
      "required": [
        "pack_id",
        "pack_version",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "challenge": {
      "type": "object",
      "properties": {
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schedule_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "challenge_id",
        "pack_id",
        "pack_version",
        "duration_ms",
        "schedule_hash",
        "ruleset_id",
        "model_fingerprint"
      ],
      "additionalProperties": false
    }
  }
}
