{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semaphore.invalid/draft-w2/manifest.schema.json",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "1-draft-w2"
    },
    "pack": {
      "$ref": "#/$defs/pack"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "minItems": 40,
      "maxItems": 5000
    },
    "test_set": {
      "type": "object",
      "minProperties": 40,
      "maxProperties": 5000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "minItems": 3,
        "maxItems": 5,
        "uniqueItems": true
      }
    },
    "test_report": {
      "$ref": "#/$defs/selfReport"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "packtool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "embedding_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "spec_version",
    "pack",
    "entries",
    "test_set"
  ],
  "additionalProperties": false,
  "$defs": {
    "pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "language": {
          "const": "en"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "author",
        "description",
        "tags",
        "language",
        "license"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "embed_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "forbidden_clues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "selfReport": {
      "type": "object",
      "properties": {
        "reachability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_rank": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000
        },
        "flagged": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "metrics_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "reachability",
        "mean_rank",
        "flagged"
      ],
      "additionalProperties": false
    }
  }
}
