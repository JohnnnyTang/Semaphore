{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semaphore.invalid/draft-w2/events.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "path",
              "code"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "game_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "server_time_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "running",
            "ended",
            "interrupted"
          ]
        },
        "board": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "entry_id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 13
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "next_spawn_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "end_reason": {
          "enum": [
            null,
            "overflow",
            "exhausted",
            "duration",
            "interrupted"
          ]
        },
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "ruleset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "challenge_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "game_id",
        "revision",
        "server_time_ms",
        "status",
        "board",
        "target_id",
        "score",
        "level",
        "next_spawn_ms",
        "end_reason",
        "pack_id",
        "pack_version",
        "ruleset_id",
        "model_fingerprint",
        "challenge_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "running"
              }
            }
          },
          "then": {
            "properties": {
              "end_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "end_reason": {
                "enum": [
                  "overflow",
                  "exhausted",
                  "duration",
                  "interrupted"
                ]
              },
              "next_spawn_ms": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "draft-w2"
        },
        "type": {
          "const": "submit_clue"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "protocol",
        "type",
        "command_id",
        "expected_revision",
        "clue"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "draft-w2"
        },
        "type": {
          "enum": [
            "snapshot",
            "state",
            "rejected",
            "game_over"
          ]
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "protocol",
        "type",
        "command_id",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "game_over"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "properties": {
                  "status": {
                    "enum": [
                      "ended",
                      "interrupted"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
