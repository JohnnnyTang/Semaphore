# Set these environment variables in your shell; .env is not automatically loaded.
# Replace the example hostname with the operator-provided LAN address.
SEMAPHORE_OLLAMA_BASE_URL=http://embedding-server:11434
SEMAPHORE_OLLAMA_TIMEOUT_SECONDS=30
SEMAPHORE_OLLAMA_BATCH_SIZE=16
# Fixed in code: qwen3-embedding:4b, native 2560 dimensions.
# After the first check, pin its full 64-hex digest from the check output:
SEMAPHORE_OLLAMA_MODEL_DIGEST=
